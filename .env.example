# ==============================================================================
# Aditya Gupta Portfolio - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# Secrets in .env are strictly ignored by Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contact Delivery Mechanism
# ------------------------------------------------------------------------------
# Options:
#   - "resend"      : (Production Recommended) Delivers transactional emails via Resend API
#                     to CONTACT_RECEIVER_EMAIL while persisting records to local SQLite.
#                     Active automatically whenever RESEND_API_KEY is configured.
#   - "database"    : (Local Default) Persists validated messages to SQLite.
#                     Provides privacy-preserving logging (PII redacted).
#   - "smtp"        : Delivers emails directly via an SMTP server (TLS/STARTTLS).
#   - "unconfigured": Simulates an unconfigured contact backend with HTTP 503 mailto fallback.
CONTACT_DELIVERY_MODE=database

# Resend Transactional Email Settings (Recommended for Production on Render)
# Sign up at https://resend.com to generate an API key (re_...)
RESEND_API_KEY=
# Recipient Email Address for contact inquiries (where notifications will be delivered)
CONTACT_RECEIVER_EMAIL=your-inbox@example.com
CONTACT_RECIPIENT_EMAIL=your-inbox@example.com
# Verified Sender address/domain permitted by Resend
# Note: "onboarding@resend.dev" is available immediately for testing to your account email.
# For production, verify your custom domain in Resend (e.g. "Aditya Portfolio <contact@yourdomain.com>").
EMAIL_FROM=Aditya Portfolio <onboarding@resend.dev>

# Path to SQLite message database (used when CONTACT_DELIVERY_MODE=database)
CONTACT_DB_PATH=backend/app/data/messages.db

# SMTP Delivery Settings (used only when CONTACT_DELIVERY_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional Administrator Secret Key for GET /api/contact/messages
# Anonymous callers cannot access contact messages. If set, requires 'X-Admin-Key' or 'Authorization: Bearer <key>'.
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration for "Ask Aditya AI"
# ------------------------------------------------------------------------------
# Supported providers:
#   - "local_fallback" : (Default) High-precision, zero-cost, grounded local rule engine.
#                        Grounded in verified portfolio records. Requires no API keys.
#   - "openai"         : Connects to OpenAI API (e.g. gpt-4o-mini).
#   - "gemini"         : Connects to Google Gemini API (e.g. gemini-1.5-flash).
#   - "ollama"         : Connects to local Ollama server (e.g. llama3.2:3b).
LLM_PROVIDER=local_fallback

# OpenAI / OpenAI-Compatible Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 3. Server, Network & CORS Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Comma-separated list of additional allowed CORS origins for production deployment
# Example: https://adityagupta.dev,https://portfolio.example.com
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Used at Vite build / runtime)
# ------------------------------------------------------------------------------
# If deploying backend separately, specify the absolute API URL (e.g. https://api.adityagupta.dev).
# If omitted or empty, the frontend uses relative paths "/api" routed through Vite dev proxy
# or Nginx reverse proxy.
# VITE_API_URL=

